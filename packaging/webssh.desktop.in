[Desktop Entry]
Type=Application
Name=webssh
GenericName=SSH control panel
Comment=Local SSH control panel with terminal, key and mount management
Exec=@EXEC@
Icon=webssh
Terminal=false
Categories=Network;RemoteAccess;
Keywords=ssh;sftp;terminal;remote;
StartupNotify=true
# Groups the chromium --app window (launched with --class=webssh) under this
# entry's icon instead of the browser's.
StartupWMClass=webssh
